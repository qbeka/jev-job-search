# OpenRouter key with access to typesafe/jev-1.13. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Shown on openrouter.ai rankings. Leave blank if you do not care.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=jev-job-search

# Optional. Who writes the answers JEV leaves open.
# By default that is Claude, through Claude Code on your subscription: leave all of this empty.
# Put a Claude API key here instead to call the Claude API directly, billed to this key.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. Picks the writer on purpose:
#   claude-code  Claude Code, even when the key above is set
#   api          the Claude API, with the key above
#   codex        the Codex CLI, signed in, on your ChatGPT plan
#   openai       any service that speaks OpenAI's chat completions (OpenAI, OpenRouter,
#                Gemini's compatible endpoint, Ollama or LM Studio on this machine)
WRITER_BACKEND=
# Optional. The model to write with. Needed for "openai"; for the others it replaces the default.
WRITER_MODEL=
# Only for "openai": the address (default https://api.openai.com/v1) and the key it wants.
# A model on this machine needs no key.
WRITER_BASE_URL=
WRITER_API_KEY=

# Optional. The full path of the Chrome (or Chromium) to drive, when it is not in a usual place.
CHROME_PATH=

# Only on a Linux machine with no keyring (no `secret-tool` command): the one password your
# job-board accounts use. Everywhere else leave this empty and run `npx jev accounts password`,
# which keeps it in the Keychain (macOS), the keyring (Linux) or Credential Manager (Windows).
JEV_ACCOUNTS_PASSWORD=
